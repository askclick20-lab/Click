# ─────────────────────────────────────────────────────────────────────────────
# Click — environment configuration
# Copy to .env and fill in what you have. NEVER commit .env. NEVER expose these
# values to a frontend: every key stays on the server.
#
# REQUIRED to start:   nothing (the server starts and reports what is missing).
# REQUIRED to answer:  at least one LLM provider key (OpenRouter, Gemini or Groq),
#                      or CLICK_DEV_MOCK_LLM=true for local development only.
# OPTIONAL:            every tool key below. Tools without credentials are skipped.
# PRODUCTION:          NODE_ENV=production, CLICK_API_KEY, explicit CORS origin(s).
#                      The server refuses to start in production with the mock LLM
#                      enabled or with CORS origin "*".
# At startup the server logs "configured / missing / default / disabled" per
# provider — never a value. /health returns booleans only.
# ─────────────────────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
CLICK_LOG_LEVEL=info
# Bearer token required on POST /chat when set. Set this before exposing the server.
CLICK_API_KEY=
# Allowed browser origin(s) for cross-origin API calls, comma-separated
# (e.g. https://Click.example). Empty: development allows localhost only,
# production allows none (the bundled web app is same-origin and needs no CORS).
# CORS_ORIGIN is accepted as an alias. "*" is refused in production.
CLICK_CORS_ORIGIN=
# Behind a reverse proxy that sets X-Forwarded-For: true (used for per-client rate limits).
TRUST_PROXY=false

# Development only: a clearly-labelled mock LLM ("[DEV MOCK]") as the last fallback,
# so the whole pipeline (real tools, streaming, UI) works without any LLM key.
# Never enable in production (the server refuses to start).
CLICK_DEV_MOCK_LLM=false

# ── Abuse protection ────────────────────────────────────────────────────────
# Rate limiting on POST /chat, per client. Empty = on, except development with the mock LLM.
RATE_LIMIT_ENABLED=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20
# Expensive requests (research mode, 3+ kinds of live sources) per client per window.
RATE_LIMIT_HEAVY_MAX_REQUESTS=5
# Request limits (rejected before any provider or tool is called).
CLICK_MAX_BODY_BYTES=262144
CLICK_MAX_MESSAGE_CHARS=8000
CLICK_MAX_HISTORY_CHARS=24000
# Hard ceiling on tool executions in one request (retries and fallbacks included; cache hits free).
CLICK_MAX_TOOL_CALLS_PER_REQUEST=12
# Models tried per answer: each at most once, never in a loop.
CLICK_MAX_MODEL_ATTEMPTS=4
# Whole-request deadline (tools + model + streaming); streams end with a clean error after it.
CLICK_REQUEST_TIMEOUT_MS=120000
# Streamed answer size cap in characters; the stream ends cleanly with a notice.
CLICK_MAX_STREAM_CHARS=60000

# ── LLM providers ───────────────────────────────────────────────────────────
# OpenRouter (main gateway — paid budget, used deliberately)
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openai/gpt-oss-120b
OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=Click
# Hard cap on OpenRouter requests per UTC day (0 = unlimited)
OPENROUTER_DAILY_REQUEST_LIMIT=200

# Google Gemini (free tier available)
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-flash-lite-latest
GEMINI_DAILY_REQUEST_LIMIT=1000

# Groq (free tier available, very fast)
GROQ_API_KEY=
# Optional backup key, used only if GROQ_API_KEY is rejected (revoked/invalid) — one retry, then the
# main key is skipped for 10 minutes. Rate limits do NOT switch keys (other providers handle those).
GROQ_API_KEY_BACKUP=
GROQ_DEFAULT_MODEL=openai/gpt-oss-120b
# Provider order is OpenRouter → Gemini → Groq for every answer, streaming included.
# true = streamed answers (the chat UI) go to Groq first for the lowest latency.
CLICK_STREAM_PREFER_GROQ=false
GROQ_DAILY_REQUEST_LIMIT=1000

# ── Routing & cost control ──────────────────────────────────────────────────
# Optional JSON file overriding src/config/routing.ts (see routing.example.json)
CLICK_ROUTING_FILE=
# rules = zero-cost keyword/entity classifier; hybrid = ask a cheap model when rules are unsure
CLICK_INTENT_MODE=rules
CLICK_MAX_OUTPUT_TOKENS=4000
CLICK_MAX_CONTEXT_CHARS=24000
CLICK_MAX_HISTORY_MESSAGES=10
CLICK_MAX_TOOL_STEPS=4
CLICK_LLM_TIMEOUT_MS=60000
CLICK_TOOL_TIMEOUT_MS=15000
CLICK_CACHE_TTL_SECONDS=600

# ── Web search (Phase 4) ────────────────────────────────────────────────────
# Tavily: https://app.tavily.com (free plan: 1,000 credits/month)
TAVILY_API_KEY=
# Exa: https://dashboard.exa.ai/api-keys (free starter credits)
EXA_API_KEY=
# Hard caps on upstream calls per UTC day (cache hits don't count; 0 = unlimited)
TAVILY_DAILY_REQUEST_LIMIT=30
EXA_DAILY_REQUEST_LIMIT=30
# Results requested per search call, and how long identical searches are cached
CLICK_SEARCH_MAX_RESULTS=5
CLICK_SEARCH_CACHE_TTL_SECONDS=900
# Sources passed to the model (normal web answers / research answers)
CLICK_MAX_SOURCES=8
CLICK_RESEARCH_MAX_SOURCES=12
# Research mode: search queries per request (1 = main query only) and how they are planned
CLICK_RESEARCH_MAX_QUERIES=3
# llm = cheap model writes sub-queries (1 extra cheap call); rules = deterministic, free
CLICK_RESEARCH_PLANNER=llm

# ── Web extraction (Phase 5) ────────────────────────────────────────────────
# Jina Reader: https://jina.ai/reader (key optional — keyless = 20 req/min; free key = 500 req/min + 10M tokens)
JINA_API_KEY=
# Set false to require a key (keyless requests are rate-limited per IP)
JINA_ALLOW_KEYLESS=true
JINA_DAILY_REQUEST_LIMIT=200
# Firecrawl: https://www.firecrawl.dev/app/api-keys (1 credit per page)
FIRECRAWL_API_KEY=
FIRECRAWL_DAILY_REQUEST_LIMIT=30
# Which extractor goes first; the other is the fallback (jina | firecrawl)
CLICK_EXTRACT_PRIMARY=jina
# Direct URLs read per request, characters kept per page, cache lifetime
CLICK_EXTRACT_MAX_URLS=3
CLICK_EXTRACT_MAX_CHARS=20000
CLICK_EXTRACT_CACHE_TTL_SECONDS=3600
# Research mode: how many top snippet-only search results to read in full (0 = off)
CLICK_RESEARCH_EXTRACT_TOP=2
# Comma-separated domains never fetched or cited
CLICK_BLOCKED_DOMAINS=

# ── GitHub (Phase 6) ────────────────────────────────────────────────────────
# Optional. Without a token: public repos, 60 API requests/hour per IP.
# With a fine-grained token (read-only "Contents", "Metadata", "Issues", "Pull requests"): 5,000/hour + private repos it can access.
# Create at https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=
# Use the public API without a token (and retry without it if the token is rejected)
GITHUB_ALLOW_UNAUTHENTICATED=true
# Limits per question (MAX_GITHUB_FILES / MAX_FILE_SIZE / MAX_TOTAL_CONTENT / MAX_COMMITS / MAX_ISSUES / MAX_PR_RESULTS)
GITHUB_MAX_FILES=6
GITHUB_MAX_FILE_SIZE=60000
GITHUB_MAX_TOTAL_CONTENT=20000
GITHUB_MAX_COMMITS=10
GITHUB_MAX_ISSUES=10
GITHUB_MAX_PR_RESULTS=10
GITHUB_MAX_RELEASES=5
GITHUB_MAX_CONTRIBUTORS=10
GITHUB_MAX_TREE_ENTRIES=50000
# Hard cap on GitHub API calls per question (raw file downloads don't count against GitHub's quota)
GITHUB_MAX_REQUESTS_PER_QUESTION=12
GITHUB_MAX_REPOS=2
GITHUB_DAILY_REQUEST_LIMIT=500
GITHUB_CACHE_TTL_SECONDS=900
# Private repository content is cached only briefly
GITHUB_PRIVATE_CACHE_TTL_SECONDS=60
GITHUB_TIMEOUT_MS=30000

# ── News / RSS (Phase 7) ────────────────────────────────────────────────────
# The free, low-cost freshness layer. Feeds are configured in feeds.json (edit freely).
RSS_ENABLED=true
RSS_FEEDS_FILE=feeds.json
# Overrides (take precedence over the file):
#   RSS_FEEDS_JSON=[{"name":"My feed","url":"https://example.com/rss","category":"ai"}]
#   RSS_FEEDS=ai|My AI feed|https://example.com/ai.xml, https://example.com/other.xml
RSS_FEEDS_JSON=
RSS_FEEDS=
# A feed is re-fetched at most this often (conditional requests; requests in between use the cache)
RSS_REFRESH_MINUTES=15
RSS_TIMEOUT_MS=8000
RSS_MAX_FEEDS_PER_REQUEST=12
RSS_MAX_ITEMS_PER_FEED=50
RSS_MAX_FEED_BYTES=2000000
# A failing feed is skipped and not retried for this long (its last good copy is used meanwhile)
RSS_FAILURE_BACKOFF_MINUTES=10
# Default freshness window (questions can narrow/widen it: "last 6 hours", "this week")
NEWS_MAX_AGE_HOURS=24
NEWS_MAX_STORIES=8
# Fewer matching RSS stories than this → complement with one web search (Tavily/Exa)
NEWS_MIN_RSS_STORIES=3
# auto | always | never — when web search complements RSS
NEWS_WEB_COMPLEMENT=auto
# Top stories with thin feed text read in full via Jina/Firecrawl (0 = never)
NEWS_EXTRACT_TOP=1

# ── Solana on-chain ──────────────────────────────────────────────────────────
# Never paste seed phrases or private keys into Click, logs, or tickets.
# false = chain tool and /api lookup-style routes report not configured.
# Production: true plus a paid SOLANA_RPC_URL.
ONCHAIN_ENABLED=false
# mainnet-beta | devnet — cluster, default RPC, and genesis hash defaults
SOLANA_NETWORK=mainnet-beta
# Default: https://api.mainnet-beta.solana.com (heavily rate-limited — not for production).
# Production: your provider URL (treated as a secret; never expose to the browser).
SOLANA_RPC_URL=
# Extra RPC URLs tried when the primary fails (comma-separated secrets)
SOLANA_RPC_FALLBACK_URLS=
# Expected genesis hash; RPC is verified against it (mainnet-beta default documented in docs/DECISIONS.md)
SOLANA_GENESIS_HASH=
# Explorer base for tx/account/token/block links (default https://solscan.io); "none" disables links
SOLANA_EXPLORER_URL=
# Optional Helius JSON-RPC / enriched APIs — https://helius.dev
HELIUS_API_KEY=
HELIUS_DAILY_REQUEST_LIMIT=2000
# Bounds (MAX_TRANSACTIONS / MAX_LOG_RESULTS / MAX_ADDRESSES / ONCHAIN_BLOCK_WINDOW)
ONCHAIN_BLOCK_WINDOW=20
ONCHAIN_MAX_TRANSACTIONS=25
ONCHAIN_MAX_LOG_RESULTS=200
ONCHAIN_MAX_ADDRESSES=3
ONCHAIN_MAX_RPC_CALLS=25
ONCHAIN_MAX_EXPLORER_CALLS=12
ONCHAIN_RPC_TIMEOUT_MS=10000
ONCHAIN_RPC_RETRIES=2
ONCHAIN_TIMEOUT_MS=30000
# Cache: stable data (mined blocks, receipts, token metadata) vs live data (latest block, balances, stats)
ONCHAIN_CACHE_TTL_SECONDS=3600
ONCHAIN_LIVE_TTL_SECONDS=10
ONCHAIN_DAILY_REQUEST_LIMIT=2000

# ── Market data: GeckoTerminal (Phase 9) — free public API, no key ──────────
MARKET_ENABLED=true
GECKOTERMINAL_API_URL=https://api.geckoterminal.com/api/v2
# GeckoTerminal network id — Solana = "solana"
GECKOTERMINAL_NETWORK=solana
# Public API allows 30 calls/minute; stay below it
GECKOTERMINAL_RATE_LIMIT_PER_MINUTE=25
GECKOTERMINAL_TIMEOUT_MS=10000
GECKOTERMINAL_RETRIES=1
# Cache (seconds): live prices/pool stats · pool lists · token metadata & network list
MARKET_CACHE_TTL=30
POOL_CACHE_TTL=60
TOKEN_METADATA_CACHE_TTL=3600
MARKET_TRENDING_TTL=60
# During an outage, last-known data up to this age may be shown — always labelled STALE (0 = never)
MARKET_STALE_MAX_SECONDS=900
MARKET_MAX_POOLS=5
MARKET_MAX_TRADES=15
MARKET_OHLCV_DAYS=7
MARKET_MAX_REQUESTS_PER_QUESTION=6
MARKET_DAILY_REQUEST_LIMIT=2000
# Pulse/overview hide thin pools; radar/new launches use a lower floor (no DEX fee % filter)
MARKET_MIN_LIQUIDITY_USD=100000
MARKET_RADAR_MIN_LIQUIDITY_USD=1000
PORTFOLIO_MAX_PRICED_TOKENS=30
DISCOVERY_SAFETY_CONCURRENCY=3
DISCOVERY_MAX_LAUNCHES=8
