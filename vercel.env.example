# Paste these entries into the Vercel project's Environment Variables.
# Replace every placeholder before deploying. Keep credentials server-side.

NODE_ENV=production
CLICK_LOG_LEVEL=info

# Set this to your production deployment origin (or custom domain), e.g. https://click.example.com
CLICK_CORS_ORIGIN=https://your-project.vercel.app

# At least one LLM key is required. The local setup uses Groq; add a key from https://console.groq.com/keys
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_DEFAULT_MODEL=openai/gpt-oss-120b

# On-chain features require a paid RPC provider in production.
ONCHAIN_ENABLED=true
SOLANA_NETWORK=mainnet-beta
SOLANA_RPC_URL=https://replace-with-your-paid-solana-rpc-url

# Optional enrichment; remove these lines if you do not have the corresponding keys.
HELIUS_API_KEY=replace-with-your-helius-api-key
GITHUB_TOKEN=replace-with-your-github-token

# Public, keyless sources and built-in abuse limits.
MARKET_ENABLED=true
GECKOTERMINAL_NETWORK=solana
RSS_ENABLED=true
JINA_ALLOW_KEYLESS=true
GITHUB_ALLOW_UNAUTHENTICATED=true
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_HEAVY_MAX_REQUESTS=5

# Do not set CLICK_API_KEY for the bundled public web UI: the browser client does not send
# bearer credentials. Protect public deployments with Vercel access controls or firewall rules.